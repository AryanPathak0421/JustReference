# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Must be a replica set (transactions). `npm run db -w @jr/api` starts a local one on 27117.
MONGODB_URI=mongodb://127.0.0.1:27117/justreference?replicaSet=rs0

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173

# Public address of the web app (used in links inside SMS/WhatsApp/email).
PUBLIC_WEB_URL=http://localhost:5173

# At least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# 32-byte key, base64. Used to encrypt PAN/Aadhaar/bank numbers (Phase 3+).
FIELD_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# OTP / SMS / WhatsApp / email provider. "console" stores messages in a dev-only outbox
# (GET /api/v1/dev/outbox) instead of sending them. Real providers are added in Phase 6.
MESSAGING_DRIVER=console

# Payments: none | sandbox (simulated gateway, no real money). In production, sandbox also needs ALLOW_SANDBOX_PAYMENTS=true.
PAYMENT_DRIVER=none

# First Super Admin, created by `npm run seed -w @jr/api` if no super admin exists.
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_MOBILE=
SEED_SUPERADMIN_PASSWORD=
# seed:demo only — lets you sign in as the root SAMPLE member aarav.sharma@example.test
SEED_DEMO_MEMBER_PASSWORD=
# seed:demo only — demo Admin admin@example.test and SAMPLE vendor sungrid-energy@example.test
SEED_DEMO_ADMIN_PASSWORD=
SEED_DEMO_VENDOR_PASSWORD=

LOG_LEVEL=info
