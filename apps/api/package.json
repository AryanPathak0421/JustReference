{
  "name": "@jr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JustReference REST API (Express + MongoDB)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:local": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "seed:demo:local": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/seed/run.ts --demo",
    "db": "node scripts/dev-db.mjs",
    "seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/seed/run.ts --demo",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jr/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
